rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          '24chanc@students.watfordboys.org',
          'sherlockccl168@gmail.com'
        ];
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
